{
  "name": "abc-astro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "budget": "node scripts/budget.mjs",
    "verify": "npm run check && npm test && npm run build && npm run test:build && npm run budget",
    "test:build": "node --test tests/build/*.test.mjs"
  },
  "dependencies": {
    "astro": "7.4.2",
    "@astrojs/sitemap": "3.7.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "typescript": "~6.0.0",
    "@playwright/test": "1.64.1",
    "@axe-core/playwright": "4.14.0"
  }
}
