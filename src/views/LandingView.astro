---
import type { CollectionEntry } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import Hero from '../components/sections/Hero.astro';
import Features from '../components/sections/Features.astro';
import Faq from '../components/sections/Faq.astro';
import CallToAction from '../components/sections/CallToAction.astro';
import Action from '../components/ui/Action.astro';
import { localizedPath } from '../lib/routes';
import { ui } from '../i18n/ui';
interface Props { landing: CollectionEntry<'landings'>['data'] }
const { landing } = Astro.props;
const t = ui(landing.locale);
const href = localizedPath(landing.locale, 'app');
---
<SiteLayout title={landing.name} description={landing.description} locale={landing.locale} path={`landing/${landing.slug}`} kind={landing.kind}>
  <Hero title={landing.title} description={landing.description}><Action slot="actions" href={href}>{landing.action}</Action></Hero>
  {landing.sections.map((section) => section === 'features'
    ? <Features title={landing.name} items={landing.features} />
    : section === 'faq' ? <Faq title={t.faq} items={landing.faq} />
    : <CallToAction title={t.calculator} href={href} label={landing.action} />)}
</SiteLayout>
