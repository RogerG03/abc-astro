---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import Hero from '../components/sections/Hero.astro';
import Faq from '../components/sections/Faq.astro';
import Action from '../components/ui/Action.astro';
import { localizedPath, type Locale } from '../lib/routes';
import { ui } from '../i18n/ui';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = ui(locale);
const entries = (await getCollection('landings', ({data}) => data.locale === locale)).sort((a,b) => a.data.slug.localeCompare(b.data.slug));
---
<SiteLayout title={t.title} description={t.intro} locale={locale}>
  <Hero title={t.title} description={t.intro}><Action slot="actions" href="#templates">{t.explore}</Action></Hero>
  <section id="templates" class="catalogue wrap"><h2>{t.collection}</h2><div class="recipe-list">
    {entries.map(({ data }) => <a class:list={['recipe', data.kind]} href={localizedPath(locale, `landing/${data.slug}`)}><span>{data.name}</span><strong>{data.title}</strong><span>{t.open} ↗</span></a>)}
  </div></section>
  <section class="statement wrap"><h2>{t.approach}</h2><p>{t.detail}</p><a href={localizedPath(locale, 'app')}>{t.app} →</a></section>
  <Faq title={t.faq} items={[{question:t.question,answer:t.answer}]} />
</SiteLayout>
