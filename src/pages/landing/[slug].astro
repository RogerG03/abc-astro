---
import { getCollection } from 'astro:content';
import View from '../../views/LandingView.astro';
export async function getStaticPaths() {
  return (await getCollection('landings', ({data}) => data.locale === 'es')).map(({data}) => ({ params: { slug: data.slug }, props: { landing: data } }));
}
const { landing } = Astro.props;
---
<View landing={landing} />
